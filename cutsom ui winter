-- Preset Animations
function WinterUI:AnimateIn(object, animType, duration)
    animType = animType or "Fade"
    duration = duration or 0.3
    
    if animType == "Fade" then
        object.BackgroundTransparency = 1
        Tween(object, {BackgroundTransparency = 0}, duration)
    elseif animType == "Scale" then
        object.Size = UDim2.new(0, 0, 0, 0)
        Tween(object, {Size = UDim2.new(1, 0, 1, 0)}, duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    elseif animType == "Slide" then
        local originalPos = object.Position
        object.Position = UDim2.new(object.Position.X.Scale, object.Position.X.Offset - 100, object.Position.Y.Scale, object.Position.Y.Offset)
        Tween(object, {Position = originalPos}, duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end
end

function WinterUI:AnimateOut(object, animType, duration)
    animType = animType or "Fade"
    duration = duration or 0.3
    
    if animType == "Fade" then
        Tween(object, {BackgroundTransparency = 1}, duration)
    elseif animType == "Scale" then
        Tween(object, {Size = UDim2.new(0, 0, 0, 0)}, duration, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    elseif animType == "Slide" then
        Tween(object, {Position = UDim2.new(object.Position.X.Scale, object.Position.X.Offset - 100, object.Position.Y.Scale, object.Position.Y.Offset)}, duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    end
end

-- Utility: Auto-Theme Based on Time
function WinterUI:GetTimeBasedTheme()
    local hour = os.date("*t").hour
    
    if hour >= 6 and hour < 12 then
        return "Ocean" -- Morning
    elseif hour >= 12 and hour < 18 then
        return "Gold" -- Afternoon
    elseif hour >= 18 and hour < 21 then
        return "Sunset" -- Evening
    else
        return "Midnight" -- Night
    end
end

