    notifType = notifType or "info"
    
    local notifColors = {
        info = WinterUI.CurrentTheme.Primary,
        success = Color3.fromRGB(46, 204, 113),
        warning = Color3.fromRGB(241, 196, 15),
        error = Color3.fromRGB(231, 76, 60)
    }
    
    local notif = CreateRoundedFrame(self.Container, UDim2.new(1, 0, 0, 80), UDim2.new(0, 0, 0, 0), WinterUI.CurrentTheme.Background, 10)
    notif.ClipsDescendants = true
    notif.Size = UDim2.new(1, 0, 0, 0)
    
    CreateStroke(notif, notifColors[notifType] or WinterUI.CurrentTheme.Primary, 2)
    
    local accentBar = CreateRoundedFrame(notif, UDim2.new(0, 4, 1, 0), UDim2.new(0, 0, 0, 0), notifColors[notifType] or WinterUI.CurrentTheme.Primary, 0)
    
    local titleLabel = Instance.new("TextLabel")
