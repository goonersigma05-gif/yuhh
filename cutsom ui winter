-- Utility Functions
local function Tween(object, properties, duration, easingStyle, easingDirection)
    duration = duration or 0.3
    easingStyle = easingStyle or Enum.EasingStyle.Quad
    easingDirection = easingDirection or Enum.EasingDirection.Out
    
    local tweenInfo = TweenInfo.new(duration, easingStyle, easingDirection)
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

local function CreateRoundedFrame(parent, size, position, backgroundColor, cornerRadius)
    local frame = Instance.new("Frame")
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = backgroundColor
    frame.BorderSizePixel = 0
    frame.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, cornerRadius or 8)
    corner.Parent = frame
    
    return frame
end

local function CreateGradient(parent, colors, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(colors)
    gradient.Rotation = rotation or 90
    gradient.Parent = parent
    return gradient
end

local function CreateStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function CreateShadow(parent)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.7
    shadow.Size = UDim2.new(1, 30, 1, 30)
    shadow.Position = UDim2.new(0, -15, 0, -15)
    shadow.ZIndex = parent.ZIndex - 1
    shadow.Parent = parent
    return shadow
end

-- Snowflake System
local SnowflakeSystem = {}
SnowflakeSystem.__index = SnowflakeSystem

function SnowflakeSystem.new(parent)
    local self = setmetatable({}, SnowflakeSystem)
    self.Parent = parent
    self.Snowflakes = {}
    self.Active = true
    
    self.Container = Instance.new("Frame")
    self.Container.Name = "SnowflakeContainer"
    self.Container.Size = UDim2.new(1, 0, 1, 0)
    self.Container.BackgroundTransparency = 1
    self.Container.ZIndex = 1
    self.Container.Parent = parent
    
    self:Start()
    return self
end

function SnowflakeSystem:CreateSnowflake()
    local snowflake = Instance.new("ImageLabel")
    snowflake.Name = "Snowflake"
    snowflake.BackgroundTransparency = 1
    snowflake.Image = "rbxassetid://6031068426"
    snowflake.ImageColor3 = Color3.fromRGB(255, 255, 255)
    snowflake.ImageTransparency = math.random(0, 50) / 100
    
    local size = math.random(10, 25)
    snowflake.Size = UDim2.new(0, size, 0, size)
    snowflake.Position = UDim2.new(math.random(0, 100) / 100, 0, -0.1, 0)
    snowflake.ZIndex = 2
    snowflake.Parent = self.Container
    
    local fallDuration = math.random(8, 15)
    local swayAmount = math.random(-50, 50)
    
    coroutine.wrap(function()
        local tween = Tween(snowflake, {
            Position = UDim2.new(snowflake.Position.X.Scale + (swayAmount / 1000), 0, 1.1, 0)
        }, fallDuration, Enum.EasingStyle.Linear)
        
        tween.Completed:Connect(function()
            snowflake:Destroy()
            table.remove(self.Snowflakes, table.find(self.Snowflakes, snowflake))
        end)
        
        -- Rotation animation
        local rotationSpeed = math.random(-360, 360)
        while snowflake.Parent do
            snowflake.Rotation = snowflake.Rotation + (rotationSpeed * 0.01)
            task.wait(0.03)
        end
    end)()
    
    table.insert(self.Snowflakes, snowflake)
end

function SnowflakeSystem:Start()
    coroutine.wrap(function()
        while self.Active do
            if #self.Snowflakes < 30 then
                self:CreateSnowflake()
            end
            task.wait(math.random(200, 500) / 1000)
        end
    end)()
end

function SnowflakeSystem:Stop()
    self.Active = false
    for _, snowflake in pairs(self.Snowflakes) do
        snowflake:Destroy()
    end
    self.Snowflakes = {}
end

