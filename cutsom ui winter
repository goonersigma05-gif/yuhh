            valueLabel.Size = UDim2.new(0, 50, 0, 20)
            valueLabel.Position = UDim2.new(1, -55, 0, 5)
            valueLabel.BackgroundTransparency = 1
            valueLabel.Text = tostring(defaultValue)
            valueLabel.Font = Enum.Font.GothamBold
            valueLabel.TextSize = 12
            valueLabel.TextColor3 = WinterUI.CurrentTheme.Accent
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.ZIndex = 18
            valueLabel.Parent = sliderFrame
            
            local sliderBar = CreateRoundedFrame(sliderFrame, UDim2.new(1, -20, 0, 6), UDim2.new(0, 10, 1, -16), Color3.fromRGB(40, 40, 50), 3)
            sliderBar.ZIndex = 18
            
            local sliderFill = CreateRoundedFrame(sliderBar, UDim2.new(0.5, 0, 1, 0), UDim2.new(0, 0, 0, 0), WinterUI.CurrentTheme.Primary, 3)
            sliderFill.ZIndex = 19
            
            CreateGradient(sliderFill, {WinterUI.CurrentTheme.Primary, WinterUI.CurrentTheme.Accent}, 0)
            
            local sliderHandle = CreateRoundedFrame(sliderBar, UDim2.new(0, 16, 0, 16), UDim2.new(0.5, -8, 0.5, -8), WinterUI.CurrentTheme.Primary, 8)
            sliderHandle.ZIndex = 20
            
            CreateStroke(sliderHandle, WinterUI.CurrentTheme.Accent, 2)
            
            local dragging = false
            local currentValue = defaultValue
            
            local function updateSlider(value)
                value = math.clamp(value, minValue, maxValue)
                value = math.floor((value / increment) + 0.5) * increment
                currentValue = value
                
                local percentage = (value - minValue) / (maxValue - minValue)
                
                Tween(sliderFill, {Size = UDim2.new(percentage, 0, 1, 0)}, 0.1)
                Tween(sliderHandle, {Position = UDim2.new(percentage, -8, 0.5, -8)}, 0.1)
                
                valueLabel.Text = tostring(value)
                pcall(callback, value)
            end
            
            updateSlider(defaultValue)
            
            sliderBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                end
            end)
            
            sliderBar.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local mousePos = input.Position.X
                    local barPos = sliderBar.AbsolutePosition.X
                    local barSize = sliderBar.AbsoluteSize.X
                    local percentage = math.clamp((mousePos - barPos) / barSize, 0, 1)
                    local value = minValue + (percentage * (maxValue - minValue))
                    updateSlider(value)
                end
            end)
            
            local SliderObj = {Frame = sliderFrame, Value = currentValue}
            
            function SliderObj:SetValue(value)
                updateSlider(value)
            end
            
            table.insert(Tab.Elements, SliderObj)
            return SliderObj
        end
        
