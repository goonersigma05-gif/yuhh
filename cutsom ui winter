-- Snowflake Animation
local function createSnowflake(parent)
    local snowflake = Instance.new("Frame")
    snowflake.Size = UDim2.new(0, math.random(3, 8), 0, math.random(3, 8))
    snowflake.Position = UDim2.new(math.random(0, 100) / 100, 0, 0, -10)
    snowflake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    snowflake.BackgroundTransparency = math.random(30, 70) / 100
    snowflake.BorderSizePixel = 0
    snowflake.ZIndex = 1000
    snowflake.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = snowflake
    
    return snowflake
end

local function animateSnowflake(snowflake, parent)
    local fallDuration = math.random(8, 15)
    local endY = parent.AbsoluteSize.Y + 20
    local horizontalDrift = math.random(-50, 50)
    
    local tween = TweenService:Create(snowflake, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(snowflake.Position.X.Scale, horizontalDrift, 1, endY)
    })
    
    tween:Play()
    tween.Completed:Connect(function()
        snowflake:Destroy()
        table.remove(snowflakes, table.find(snowflakes, snowflake))
    end)
    
    table.insert(snowflakes, snowflake)
end

local function startSnowfall(parent)
    RunService.Heartbeat:Connect(function()
        if math.random(1, 100) <= 5 and #snowflakes < 50 then
            local snowflake = createSnowflake(parent)
            animateSnowflake(snowflake, parent)
        end
    end)
end

