-- Progress Tracker
function WinterUI:CreateProgressTracker(parent, config)
    config = config or {}
    local title = config.Title or "Progress"
    local steps = config.Steps or {"Step 1", "Step 2", "Step 3"}
    
    local trackerFrame = CreateRoundedFrame(parent, UDim2.new(1, 0, 0, 60 + (#steps * 40)), UDim2.new(0, 0, 0, 0), Color3.fromRGB(25, 25, 35), 8)
    trackerFrame.Name = "ProgressTracker"
    trackerFrame.ZIndex = 17
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 30)
    titleLabel.Position = UDim2.new(0, 10, 0, 10)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 14
    titleLabel.TextColor3 = WinterUI.CurrentTheme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 18
    titleLabel.Parent = trackerFrame
    
    local currentStep = 1
    local stepFrames = {}
    
    for i, step in ipairs(steps) do
        local stepContainer = Instance.new("Frame")
        stepContainer.Size = UDim2.new(1, -20, 0, 35)
        stepContainer.Position = UDim2.new(0, 10, 0, 45 + ((i - 1) * 40))
        stepContainer.BackgroundTransparency = 1
        stepContainer.ZIndex = 18
        stepContainer.Parent = trackerFrame
        
        local stepCircle = CreateRoundedFrame(stepContainer, UDim2.new(0, 25, 0, 25), UDim2.new(0, 0, 0, 5), Color3.fromRGB(40, 40, 50), 13)
        stepCircle.ZIndex = 19
        
        CreateStroke(stepCircle, WinterUI.CurrentTheme.Primary, 2)
        
        local stepNumber = Instance.new("TextLabel")
        stepNumber.Size = UDim2.new(1, 0, 1, 0)
        stepNumber.BackgroundTransparency = 1
        stepNumber.Text = tostring(i)
        stepNumber.Font = Enum.Font.GothamBold
        stepNumber.TextSize = 12
        stepNumber.TextColor3 = WinterUI.CurrentTheme.Text
        stepNumber.ZIndex = 20
        stepNumber.Parent = stepCircle
        
        local stepLabel = Instance.new("TextLabel")
        stepLabel.Size = UDim2.new(1, -40, 1, 0)
        stepLabel.Position = UDim2.new(0, 35, 0, 0)
        stepLabel.BackgroundTransparency = 1
        stepLabel.Text = step
        stepLabel.Font = Enum.Font.Gotham
        stepLabel.TextSize = 12
        stepLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        stepLabel.TextXAlignment = Enum.TextXAlignment.Left
        stepLabel.ZIndex = 19
        stepLabel.Parent = stepContainer
        
        table.insert(stepFrames, {Circle = stepCircle, Label = stepLabel, Number = stepNumber})
        
        if i < #steps then
            local connector = CreateRoundedFrame(trackerFrame, UDim2.new(0, 2, 0, 30), UDim2.new(0, 21, 0, 75 + ((i - 1) * 40)), Color3.fromRGB(50, 50, 60), 1)
            connector.ZIndex = 18
        end
    end
    
    local Tracker = {Frame = trackerFrame, CurrentStep = currentStep, Steps = stepFrames}
    
    function Tracker:NextStep()
        if self.CurrentStep < #self.Steps then
            local prevStep = self.Steps[self.CurrentStep]
            Tween(prevStep.Circle, {BackgroundColor3 = WinterUI.CurrentTheme.Primary}, 0.3)
            prevStep.Number.Text = "✓"
            prevStep.Label.TextColor3 = WinterUI.CurrentTheme.Text
            
            self.CurrentStep = self.CurrentStep + 1
            local currentStep = self.Steps[self.CurrentStep]
            Tween(currentStep.Circle, {BackgroundColor3 = WinterUI.CurrentTheme.Accent}, 0.3)
        end
    end
    
    function Tracker:SetStep(step)
        if step >= 1 and step <= #self.Steps then
            for i, stepFrame in ipairs(self.Steps) do
                if i < step then
                    Tween(stepFrame.Circle, {BackgroundColor3 = WinterUI.CurrentTheme.Primary}, 0.3)
                    stepFrame.Number.Text = "✓"
                    stepFrame.Label.TextColor3 = WinterUI.CurrentTheme.Text
                elseif i == step then
                    Tween(stepFrame.Circle, {BackgroundColor3 = WinterUI.CurrentTheme.Accent}, 0.3)
                    stepFrame.Number.Text = tostring(i)
                    stepFrame.Label.TextColor3 = WinterUI.CurrentTheme.Text
                else
                    Tween(stepFrame.Circle, {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}, 0.3)
                    stepFrame.Number.Text = tostring(i)
                    stepFrame.Label.TextColor3 = Color3.fromRGB(150, 150, 150)
                end
            end
            self.CurrentStep = step
        end
    end
    
    -- Initialize first step
    Tracker:SetStep(1)
    
    return Tracker
end

-- Rating System
function WinterUI:CreateRating(parent, config)
    config = config or {}
    local title = config.Title or "Rating"
    local maxStars = config.MaxStars or 5
    local defaultRating = config.Default or 0
    local callback = config.Callback or function() end
    
    local ratingFrame = CreateRoundedFrame(parent, UDim2.new(1, 0, 0, 60), UDim2.new(0, 0, 0, 0), Color3.fromRGB(25, 25, 35), 8)
    ratingFrame.Name = "Rating"
    ratingFrame.ZIndex = 17
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 25)
    titleLabel.Position = UDim2.new(0, 10, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    titleLabel.TextColor3 = WinterUI.CurrentTheme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 18
    titleLabel.Parent = ratingFrame
    
    local starsContainer = Instance.new("Frame")
    starsContainer.Size = UDim2.new(0, maxStars * 35, 0, 30)
    starsContainer.Position = UDim2.new(0, 10, 0, 25)
    starsContainer.BackgroundTransparency = 1
    starsContainer.ZIndex = 18
    starsContainer.Parent = ratingFrame
    
    local currentRating = defaultRating
    local stars = {}
    
    for i = 1, maxStars do
        local star = Instance.new("TextButton")
        star.Size = UDim2.new(0, 30, 0, 30)
        star.Position = UDim2.new(0, (i - 1) * 35, 0, 0)
        star.BackgroundTransparency = 1
        star.Text = "★"
        star.Font = Enum.Font.GothamBold
        star.TextSize = 24
        star.TextColor3 = i <= defaultRating and Color3.fromRGB(255, 193, 7) or Color3.fromRGB(100, 100, 100)
        star.ZIndex = 19
        star.Parent = starsContainer
        
        star.MouseButton1Click:Connect(function()
            currentRating = i
            for j, s in ipairs(stars) do
                Tween(s, {TextColor3 = j <= i and Color3.fromRGB(255, 193, 7) or Color3.fromRGB(100, 100, 100)}, 0.2)
            end
            pcall(callback, i)
        end)
        
        star.MouseEnter:Connect(function()
            for j, s in ipairs(stars) do
                if j <= i then
                    Tween(s, {TextColor3 = Color3.fromRGB(255, 215, 0)}, 0.1)
                end
            end
        end)
        
        star.MouseLeave:Connect(function()
            for j, s in ipairs(stars) do
                Tween(s, {TextColor3 = j <= currentRating and Color3.fromRGB(255, 193, 7) or Color3.fromRGB(100, 100, 100)}, 0.1)
            end
        end)
        
        table.insert(stars, star)
    end
    
    local RatingObj = {Frame = ratingFrame, Rating = currentRating, Stars = stars}
    
    function RatingObj:SetRating(rating)
        rating = math.clamp(rating, 0, maxStars)
        currentRating = rating
        self.Rating = rating
        for i, star in ipairs(stars) do
            Tween(star, {TextColor3 = i <= rating and Color3.fromRGB(255, 193, 7) or Color3.fromRGB(100, 100, 100)}, 0.2)
        end
    end
    
    return RatingObj
end

