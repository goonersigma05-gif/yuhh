-- Set Theme
function WinterUI:SetTheme(themeName)
    if Themes[themeName] then
        currentTheme = Themes[themeName]
        -- Update all UI elements with new theme (simplified)
        if currentWindow and currentWindow.MainFrame then
            for _, obj in ipairs(currentWindow.MainFrame:GetDescendants()) do
                if obj:IsA("UIStroke") and obj.Parent.Name ~= "TabsContainer" then
                    obj.Color = currentTheme.primary
                end
            end
        end
    end
end

return WinterUI
